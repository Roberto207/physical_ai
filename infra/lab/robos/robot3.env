# Segundo robô do lab, no Wi-Fi Robotica_Deco.
# Valores lidos do /etc/turtlebot4/setup.bash do próprio robô em 2026-11-25.
# Série do Raspberry Pi: 1000000044bad95f
# O IP vem do DHCP e pode mudar: confira com "ip -br addr" no robô e ajuste a última linha.

# Prefixo dos tópicos do robô (ROBOT_NAMESPACE no robô).
ROBO_NS=/robot3

# O "canal" do ROS 2. Precisa ser igual ao do robô (0 a 232).
# https://turtlebot.github.io/turtlebot4-user-manual/setup/simple_discovery.html
ROS_DOMAIN_ID=0

# Servidor de descoberta, que roda no robô. A POSIÇÃO na lista é o server ID:
# id 0 = "IP:11811;", id 1 = ";IP:11811;", id 3 = ";;;IP:11811;".
# https://turtlebot.github.io/turtlebot4-user-manual/setup/discovery_server.html
ROS_DISCOVERY_SERVER=;;;192.168.68.53:11811;
