# Rede do PC do laboratório para falar com o TurtleBot 4 (ROS 2 Humble).
#
# Quem lê este arquivo: os serviços de infra/compose/robo.yaml ("env_file"). O sim.yaml NÃO
# lê: o Gazebo usa o domínio 42 de propósito, para nunca falar com o robô real.
# Formato do Docker: uma linha CHAVE=valor, sem "export" e SEM aspas (aspas viram parte do
# valor). Linhas com "#" no começo são ignoradas.
#
# Isto configura SÓ o lado do PC. Não muda nada no robô. Não altere a rede do robô sem
# autorização da equipe do INF.
#
# Preenchido para o robô do laboratório (2026-11-16). Se o robô ou o IP mudar, ajuste o
# ROS_DISCOVERY_SERVER e teste: infra/docker/lab.sh robo checar-rede (só lê; precisa dizer REDE OK).

# O "canal" do ROS 2. Precisa ser igual ao do robô (0 a 232). O manual usa 0 nos dois modos.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/simple_discovery.html
ROS_DOMAIN_ID=0

# O "idioma" (middleware DDS). O TurtleBot 4 usa o FastDDS, e o PC precisa do mesmo.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/basic.html
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# No PC, evita portas SHM com erro open_and_lock_file e usa UDPv4 entre containers
# e até o robô. O robô não lê este arquivo. Fast DDS 2.6 aceita UDPv4 aqui.
# https://fast-dds.docs.eprosima.com/en/2.6.x/fastdds/env_vars/env_vars.html
FASTDDS_BUILTIN_TRANSPORTS=UDPv4

# Só no modo Discovery Server. Formato: IP:PORTA; (a porta padrão é 11811).
# A POSIÇÃO na lista é o server ID, como no configure_discovery.sh oficial:
#   server ID 0  ->  ROS_DISCOVERY_SERVER=192.168.0.10:11811;
#   server ID 1  ->  ROS_DISCOVERY_SERVER=;192.168.0.10:11811;     (vaga vazia para o ID 0)
# O IP aparece no topo da tela do TurtleBot 4 (o Lite não tem tela; pergunte à equipe).
# O 192.168.0.10 acima é só exemplo do formato.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/discovery_server.html
# Robô do lab (2026-11-16): ele roda o servidor com id 1 ("fast-discovery-server -i 1 -p 11811",
# ROS_DISCOVERY_SERVER=";127.0.0.1:11811;" no /etc/turtlebot4/setup.bash). O PC precisa listar
# o IP na MESMA posição (o ";" antes do IP). O IP vem do DHCP do roteador e pode mudar: confira
# com "ip -br addr" no robô (docs/guias/acesso-ao-robo.md).
# Isto só não basta: o PC também precisa de rotas para 192.168.186.0/24 e 192.168.185.0/24
# pelo IP do robô, senão a descoberta não completa. O "lab.sh robo checar-rede" confere e
# mostra o comando (docs/tarefas/2026-11-16-robo-real-rede-e-namespace.md).
ROS_DISCOVERY_SERVER=;192.168.7.7:11811;
# O serviço `ferramentas` define ROS_SUPER_CLIENT=True para inspecionar todos os tópicos.
# Os nós permanentes usam descoberta normal para trocar apenas os dados de que precisam.
