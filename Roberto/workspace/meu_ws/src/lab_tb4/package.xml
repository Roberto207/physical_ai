<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>lab_tb4</name>
  <version>0.1.0</version>
  <description>Bringup dos ambientes do TurtleBot 4 do projeto: Gazebo (Ignition Fortress) sem janela, simulador leve (loopback) com base falsa, e o teste L1 da patrulha. Spec specs/migracao-humble.</description>
  <maintainer email="nao-informado@example.com">Equipe Physical AI (INF-UFG)</maintainer>
  <license>Apache-2.0</license>

  <!-- Nós deste pacote (base_falsa, vigia_l1) -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>
  <exec_depend>rcl_interfaces</exec_depend>
  <exec_depend>irobot_create_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <!-- Launches: só existem na imagem physical-ai:sim. O colcon build não exige exec_depend. -->
  <exec_depend>ros_ign_gazebo</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>turtlebot4_ignition_bringup</exec_depend>
  <exec_depend>turtlebot4_description</exec_depend>
  <exec_depend>nav2_bringup</exec_depend>
  <exec_depend>nav2_map_server</exec_depend>
  <exec_depend>nav2_lifecycle_manager</exec_depend>
  <exec_depend>nav2_loopback_sim</exec_depend>
  <exec_depend>patrulha_tb4</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
