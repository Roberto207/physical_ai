# Rede do PC do laboratório para falar com o TurtleBot 4 (ROS 2 Jazzy).
#
# Quem lê este arquivo: os serviços de infra/compose/robo.yaml ("env_file"). O sim.yaml NÃO
# lê: o Gazebo usa o domínio 42 de propósito, para nunca falar com o robô real.
# Formato do Docker: uma linha CHAVE=valor, sem "export" e SEM aspas (aspas viram parte do
# valor). Linhas com "#" no começo são ignoradas.
#
# Isto configura SÓ o lado do PC. Não muda nada no robô. Não altere a rede do robô sem
# autorização da equipe do INF.
#
# COMO PREENCHER (no dia, com a equipe do INF; kit de campo, etapa 1):
#   1. Pergunte três coisas: o ROS_DOMAIN_ID do robô; se ele usa Simple Discovery ou
#      Discovery Server; e, se for Discovery Server, o IP do Raspberry Pi e o "server ID"
#      que foi escolhido no turtlebot4-setup (com um robô só, o manual usa 0).
#   2. Se o domínio não for 0, troque o ROS_DOMAIN_ID abaixo.
#   3. Simple Discovery: não mexa em mais nada.
#      Discovery Server: tire o "#" da linha do ROS_DISCOVERY_SERVER e ponha o IP.
#   4. Teste: infra/docker/lab.sh robo checar-rede   (só lê; precisa dizer REDE OK)

# O "canal" do ROS 2. Precisa ser igual ao do robô (0 a 232). O manual usa 0 nos dois modos.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/simple_discovery.html
ROS_DOMAIN_ID=0

# O "idioma" (middleware DDS). No Jazzy, o TurtleBot 4 usa o FastDDS, e o PC precisa do mesmo.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/basic.html
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Só no modo Discovery Server. Formato: IP:PORTA; (a porta padrão é 11811).
# A POSIÇÃO na lista é o server ID, como no configure_discovery.sh oficial (ramo jazzy):
#   server ID 0  ->  ROS_DISCOVERY_SERVER=192.168.0.10:11811;
#   server ID 1  ->  ROS_DISCOVERY_SERVER=;192.168.0.10:11811;     (vaga vazia para o ID 0)
# O IP aparece no topo da tela do TurtleBot 4 (o Lite não tem tela; pergunte à equipe).
# O IP abaixo é um exemplo, não o do robô do INF.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/discovery_server.html
#ROS_DISCOVERY_SERVER=192.168.0.10:11811;
