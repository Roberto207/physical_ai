# Rede do PC do laboratório para falar com o TurtleBot 4 (ROS 2 Jazzy).
#
# Lido pelos serviços de infra/compose/robo.yaml ("env_file"). Formato do Docker: uma linha
# CHAVE=valor, sem "export" e SEM aspas (aspas viram parte do valor).
#
# Isto configura SÓ o lado do PC. Não muda nada no robô. O modo de rede do robô (Simple
# Discovery ou Discovery Server) e o ROS_DOMAIN_ID são da equipe do INF: pergunte antes
# (kit de campo, etapa 1) e não altere a rede do robô sem autorização.

# Precisa ser igual ao do robô. O manual usa 0 nos dois modos.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/simple_discovery.html
ROS_DOMAIN_ID=0

# No Jazzy, o padrão do TurtleBot 4 é o FastDDS, e o PC precisa usar o mesmo middleware.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/basic.html
RMW_IMPLEMENTATION=rmw_fastrtps_cpp

# Modo Discovery Server (recomendado pelo manual para navegação e para redes de
# universidade, onde o multicast costuma falhar). Só se o robô estiver nesse modo: tire o
# "#" e troque pelo IP do Raspberry Pi do robô; a porta padrão é 11811. Com o "#", vale o
# Simple Discovery.
# https://turtlebot.github.io/turtlebot4-user-manual/setup/discovery_server.html
# Robô do lab (2026-11-16): ele roda o servidor com id 1 ("fast-discovery-server -i 1 -p 11811",
# ROS_DISCOVERY_SERVER=";127.0.0.1:11811;" no /etc/turtlebot4/setup.bash). O PC precisa listar
# o IP na MESMA posição (o ";" antes do IP). O IP vem do DHCP do roteador e pode mudar: confira
# com "ip -br addr" no robô (docs/acesso-ao-robo-por-cabo.md).
# Isto só não basta: o PC também precisa de rotas para 192.168.186.0/24 e 192.168.185.0/24
# pelo IP do robô, senão a descoberta não completa. O "lab.sh robo checar-rede" confere e
# mostra o comando (docs/tarefas/2026-11-16-robo-real-rede-e-namespace.md).
ROS_DISCOVERY_SERVER=;192.168.7.7:11811;
# Com o Discovery Server, "ros2 topic list" só enxerga tudo como super cliente (é o que o
# checar-rede usa). O manual do TurtleBot 4 usa o mesmo valor nas ferramentas do PC.
ROS_SUPER_CLIENT=True
