<?xml version="1.0"?>
<!--
  URDF de exemplo para estudo: um robô de duas rodas (como o TurtleBot, só que bem mais simples).

  Um URDF é uma ÁRVORE: um link raiz (base_link) e outros links pendurados nele por joints.

      base_link (o corpo)
        +- roda_esquerda   (joint continuo: gira sem limite)
        +- roda_direita    (joint continuo)
        +- apoio_traseiro  (joint fixo: esfera que desliza, só para o robô não tombar)
        +- lidar_link      (joint fixo: o sensor, preso em cima)

  Eixos do ROS: x = frente, y = esquerda, z = cima. Unidades: metros e quilogramas.

  Este arquivo repete as duas rodas à mão. O exemplo_robo.urdf.xacro faz o MESMO robô
  sem repetição. Compare os dois.
-->
<robot name="robo_exemplo">

  <!-- Cores (só aparecem no RViz e no Gazebo) -->
  <material name="azul"><color rgba="0.1 0.3 0.8 1"/></material>
  <material name="preto"><color rgba="0.1 0.1 0.1 1"/></material>
  <material name="cinza"><color rgba="0.6 0.6 0.6 1"/></material>

  <!-- ===================== CORPO ===================== -->
  <link name="base_link">
    <!-- visual: o que se desenha na tela -->
    <visual>
      <geometry><box size="0.4 0.25 0.1"/></geometry>
      <material name="azul"/>
    </visual>
    <!-- collision: a "caixa" usada para detectar batida (costuma ser mais simples que o visual) -->
    <collision>
      <geometry><box size="0.4 0.25 0.1"/></geometry>
    </collision>
    <!-- inertial: massa e distribuição de peso. O Gazebo exige. Valores de uma caixa de 2 kg -->
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.012083" iyy="0.028333" izz="0.037083" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <!-- ===================== RODA ESQUERDA ===================== -->
  <link name="roda_esquerda">
    <visual>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00014" iyy="0.00014" izz="0.00025" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="junta_roda_esquerda" type="continuous">
    <parent link="base_link"/>
    <child link="roda_esquerda"/>
    <!-- 14 cm para a esquerda (y positivo) e 5 cm abaixo do centro do corpo.
         rpy gira o eixo z do cilindro para apontar para o lado (y) do robô -->
    <origin xyz="0 0.14 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== RODA DIREITA (igual, do outro lado) ===================== -->
  <link name="roda_direita">
    <visual>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
      <material name="preto"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.05" length="0.03"/></geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00014" iyy="0.00014" izz="0.00025" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </link>

  <joint name="junta_roda_direita" type="continuous">
    <parent link="base_link"/>
    <child link="roda_direita"/>
    <origin xyz="0 -0.14 -0.05" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <!-- ===================== APOIO TRASEIRO ===================== -->
  <!-- Uma esfera fixa atrás. É uma simplificação: um robô real usaria uma roda boba. -->
  <link name="apoio_traseiro">
    <visual>
      <geometry><sphere radius="0.025"/></geometry>
      <material name="cinza"/>
    </visual>
    <collision>
      <geometry><sphere radius="0.025"/></geometry>
    </collision>
  </link>

  <joint name="junta_apoio" type="fixed">
    <parent link="base_link"/>
    <child link="apoio_traseiro"/>
    <origin xyz="-0.15 0 -0.075"/>
  </joint>

  <!-- ===================== LIDAR ===================== -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05"/></geometry>
      <material name="preto"/>
    </visual>
  </link>

  <joint name="junta_lidar" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <!-- 10 cm à frente do centro e em cima do corpo (o corpo tem 10 cm de altura) -->
    <origin xyz="0.1 0 0.075"/>
  </joint>

</robot>
