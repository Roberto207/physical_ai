<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>llm_tb4</name>
  <version>0.1.0</version>
  <description>Linguagem natural para o TurtleBot 4 com um LLM local (spec specs/llm-integracao). Baseado no turtlebot4_openai_tutorials.</description>
  <maintainer email="nao-informado@example.com">Equipe Physical AI (INF-UFG)</maintainer>
  <license>Apache-2.0</license>

  <depend>rclpy</depend>
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>rcl_interfaces</depend>
  <depend>action_msgs</depend>
  <depend>irobot_create_msgs</depend>
  <depend>nav2_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>turtlebot4_navigation</depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>patrulha_tb4</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
